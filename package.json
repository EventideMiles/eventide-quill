{
	"name": "eventide-quill",
	"version": "2.3.2",
	"description": "A feedback-first, novelist-focused writing assistant for Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs watch",
		"build": "npm run sass && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build:dev": "npm run sass && prettier --write 'src/**/*.ts' && tsc -noEmit -skipLibCheck && node esbuild.config.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"set-version": "node update-version.mjs",
		"release": "node release.mjs",
		"lint": "eslint . && stylelint 'styles/**/*.scss'",
		"lint:styles": "stylelint 'styles/**/*.scss'",
		"lint:fix": "eslint . --fix && prettier --write 'src/**/*.ts' && stylelint --fix 'styles/**/*.scss'",
		"lint:dup": "jscpd -c .jscpd.json -r threshold",
		"lint:dup:report": "jscpd -c .jscpd.json -r console,html -o jscpd-report",
		"lint:orphans": "knip",
		"prettier:check": "prettier --check 'src/**/*.ts'",
		"prettier:fix": "prettier --write 'src/**/*.ts'",
		"sass": "sass styles/main.scss styles.css --style=expanded --no-source-map",
		"sass:watch": "sass --watch styles/main.scss styles.css --style=expanded",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:all": "npm run test && npm run test:e2e",
		"test:e2e": "npm run build && wdio run ./wdio.conf.mts",
		"test:e2e:live": "npm run build && E2E_LIVE=1 wdio run ./wdio.conf.mts",
		"typecheck:e2e": "tsc -noEmit -skipLibCheck -p tsconfig.e2e.json",
		"dev:obsidian": "obsidian-launcher watch --copy --plugin . test/vaults/simple",
		"dev:full": "npm run setup:test-vault && npm-run-all --parallel dev dev:obsidian",
		"setup:test-vault": "node scripts/setup-test-vault.mjs"
	},
	"keywords": [],
	"license": "MIT",
	"packageManager": "npm@11.21.2",
	"engines": {
		"node": ">=24",
		"npm": ">=11.16.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "^4.1.12",
		"@wdio/cli": "^9.32.0",
		"@wdio/globals": "^9.31.2",
		"@wdio/local-runner": "^9.32.0",
		"@wdio/mocha-framework": "^9.32.0",
		"@wdio/spec-reporter": "^9.31.2",
		"chai": "^5.3.3",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-jsdoc": "^63.3.3",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"happy-dom": "^20.14.6",
		"jiti": "^2.6.1",
		"jscpd": "^5.0.11",
		"knip": "^6.29.0",
		"mocha": "^10.8.2",
		"npm-run-all2": "^7.0.2",
		"obsidian": "1.14.4",
		"obsidian-launcher": "^3.1.1",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.8.4",
		"sass": "^1.101.0",
		"stylelint": "^17.16.0",
		"stylelint-scss": "^7.2.0",
		"tslib": "^2.9.1",
		"tsx": "^4.23.15",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.12",
		"wdio-obsidian-reporter": "^3.1.1",
		"wdio-obsidian-service": "^3.1.1"
	},
	"dependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"@parcel/watcher@2.6.0": true,
		"classic-level@3.0.0": true,
		"edgedriver": false,
		"geckodriver": false
	},
	"overrides": {
		"eslint": {
			"minimatch": {
				"brace-expansion": "^1.1.18"
			}
		},
		"mocha": {
			"glob": "^13.0.6",
			"serialize-javascript": "^7.1.0"
		},
		"@wdio/config": {
			"glob": "^13.0.6"
		},
		"archiver-utils": {
			"glob": "^13.0.6"
		},
		"@wdio/utils": {
			"@puppeteer/browsers": "^3.2.0"
		}
	}
}
